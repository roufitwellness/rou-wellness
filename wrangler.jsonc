{
  "name": "rou-wellness",
  "main": "worker.js",
  "keep_vars": true,
  // "0 12 * * *"：每天台灣時間晚上 8 點（世界時間中午 12 點）寄「明天上課提醒」和老師的課表
  // "30 * * * *"：每小時檢查一次，取消超過時限還沒付訂金的預約（訂金制度開啟時才會動作）
  "triggers": { "crons": ["0 12 * * *", "30 * * * *"] },
  "compatibility_date": "2026-11-04",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/auth/*", "/admin", "/admin/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rou-feedback",
      "database_id": "f036eb2d-0e04-493d-9f33-1aa50f4eddaf"
    }
  ]
}
